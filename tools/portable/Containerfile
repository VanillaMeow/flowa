FROM docker.io/library/ubuntu:24.04 AS fixture

RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg \
    && ffmpeg -hide_banner -loglevel error -y \
        -f lavfi -i testsrc2=size=320x180:rate=24 \
        -f lavfi -i anullsrc=r=48000:cl=stereo -t 4 \
        -c:v libx264 -preset ultrafast -pix_fmt yuv420p -c:a aac /fixture.mp4

FROM docker.io/library/ubuntu:24.04 AS runtime-check

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates libvulkan1 mesa-vulkan-drivers xvfb xauth python3-pil \
        binutils patchelf libx11-6 libxrandr2 libxi6 libxcursor1 libxinerama1 libxkbcommon-x11-0 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=fixture /fixture.mp4 /fixture.mp4
COPY checks/portable.sh /tools/checks/portable.sh
COPY tests/portable.sh tests/portable-runtime.sh /tools/tests/
CMD ["bash", "-c", "/tools/tests/portable.sh /flowa && /tools/tests/portable-runtime.sh /flowa /fixture.mp4"]

FROM docker.io/library/ubuntu:24.04 AS builder

ARG RUST_VERSION=1.99.0
ENV DEBIAN_FRONTEND=noninteractive \
    RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH \
    FLOWA_MAX_GLIBC=2.39

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential ca-certificates curl pkg-config cmake meson ninja-build nasm \
        xz-utils binutils python3-jinja2 libvulkan-dev libffmpeg-nvenc-dev \
        libasound2-dev libpulse-dev libpipewire-0.3-dev \
    && rm -rf /var/lib/apt/lists/*
RUN curl --fail --location --retry 3 https://sh.rustup.rs -o /tmp/rustup-init.sh \
    && sh /tmp/rustup-init.sh -y --profile minimal --default-toolchain "$RUST_VERSION" \
    && rm /tmp/rustup-init.sh

WORKDIR /work
CMD ["bash", "tools/portable/build.sh"]
