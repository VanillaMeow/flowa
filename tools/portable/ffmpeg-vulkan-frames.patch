+// Match decode-image flags to the capabilities of the selected video profile
+static int configure_video_image_flags(AVHWFramesContext *frames) {
+    AVVulkanFramesContext *images = frames->hwctx;
+    VulkanDevicePriv *device = frames->device_ctx->hwctx;
+    FFVulkanFunctions *vk = &device->vkctx.vkfn;
+    VkImageUsageFlags required_usage = VK_IMAGE_USAGE_TRANSFER_SRC_BIT |
+        (images->usage & (VK_IMAGE_USAGE_VIDEO_DECODE_DST_BIT_KHR |
+            VK_IMAGE_USAGE_VIDEO_DECODE_DPB_BIT_KHR));
+    VkPhysicalDeviceVideoFormatInfoKHR info = {
+        .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VIDEO_FORMAT_INFO_KHR,
+        .pNext = images->create_pnext,
+        .imageUsage = required_usage,
+    };
+    uint32_t count = 0;
+    VkResult result = vk->GetPhysicalDeviceVideoFormatPropertiesKHR(
+        device->p.phys_dev,
+        &info,
+        &count,
+        NULL
+    );
+
+    if (result != VK_SUCCESS || !count)
+        return AVERROR(ENOTSUP);
+
+    VkVideoFormatPropertiesKHR *formats = av_calloc(count, sizeof(*formats));
+    if (!formats)
+        return AVERROR(ENOMEM);
+
+    for (uint32_t index = 0; index < count; index++)
+        formats[index].sType = VK_STRUCTURE_TYPE_VIDEO_FORMAT_PROPERTIES_KHR;
+
+    result = vk->GetPhysicalDeviceVideoFormatPropertiesKHR(
+        device->p.phys_dev,
+        &info,
+        &count,
+        formats
+    );
+    int error = AVERROR(ENOTSUP);
+
+    if (result == VK_SUCCESS) {
+        for (uint32_t index = 0; index < count; index++) {
+            const VkVideoFormatPropertiesKHR *format = &formats[index];
+
+            if (
+                format->format != images->format[0] ||
+                format->imageType != VK_IMAGE_TYPE_2D ||
+                format->imageTiling != images->tiling ||
+                (format->imageUsageFlags & required_usage) != required_usage
+            )
+                continue;
+
+            images->usage = required_usage |
+                (images->usage & format->imageUsageFlags & ~VK_IMAGE_USAGE_STORAGE_BIT);
+            images->img_flags &= format->imageCreateFlags;
+            error = 0;
+            break;
+        }
+    }
+
+    av_free(formats);
+
+    return error;
+}
