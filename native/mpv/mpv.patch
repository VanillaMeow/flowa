@@ -4,8 +4,14 @@
 #include "mpv/render_gl.h"
 #include "video.h"
 #include "video/out/libmpv.h"
+#if HAVE_VULKAN
+#include "video/out/vulkan/flowa_vk.h"
+#endif
 
 static const struct libmpv_gpu_context_fns *context_backends[] = {
+#if HAVE_VULKAN
+    &libmpv_gpu_context_flowa_vk,
+#endif
 #if HAVE_GL
     &libmpv_gpu_context_gl,
 #endif
@@ -158,6 +164,19 @@
 {
     struct priv *p = ctx->priv;
 
+#if HAVE_VULKAN
+    if (strcmp(p->context->fns->api_name, FLOWA_VK_API) == 0) {
+        struct flowa_vk_target *target =
+            get_mpv_render_param(params, FLOWA_VK_TARGET, NULL);
+        if (!target || !target->width || !target->height)
+            return MPV_ERROR_INVALID_PARAMETER;
+
+        *out_w = target->width;
+        *out_h = target->height;
+        return 0;
+    }
+#endif
+
     // Mapping the surface is cheap, better than adding new backend entrypoints.
     struct ra_tex *tex;
     int err = p->context->fns->wrap_fbo(p->context, params, &tex);
