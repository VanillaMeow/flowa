[Desktop Entry]
Type=Application
Name=flowa
GenericName=Image and Video Viewer
Comment=An open space for your images
Exec=flowa %f
Icon=flowa
Terminal=false
Categories=Graphics;Viewer;
MimeType=image/jpeg;image/png;image/apng;image/gif;image/webp;image/bmp;image/x-icon;image/tiff;image/svg+xml;image/svg+xml-compressed;image/jxl;image/avif;image/heic;image/heif;image/x-tga;image/x-exr;image/vnd.radiance;video/quicktime;video/mp4;video/x-m4v;video/matroska;video/x-matroska;video/webm;video/vnd.avi;video/x-msvideo;video/mpeg;video/mp2t;video/ogg;
StartupNotify=true
StartupWMClass=flowa
